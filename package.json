{
  "name": "ledge-it",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.7",
    "expo-auth-session": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.17.1",
    "papaparse": "^5.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web",
    "build": "npx expo export --platform web",
    "deploy": "npx expo export --platform web && bash post-export.sh && npx firebase deploy --only hosting",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:aab": "npx eas-cli build -p android --profile production",
    "build:android-apk": "cd android && ./gradlew assembleRelease",
    "build:android-debug": "cd android && ./gradlew assembleDebug",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "private": true
}
